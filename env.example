# ─────────────────────────────────────────────────────
#  SmartLog — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to Git — it's in .gitignore.
# ─────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────
# Local Docker Compose:
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/smartlog

# Supabase (cloud):
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# ── Auth ────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080        # 7 days

# ── Groq LLM ────────────────────────────────────────
GROQ_API_KEY=gsk_...              # Get from console.groq.com
GROQ_MODEL=llama-3.3-70b-versatile

# ── App ─────────────────────────────────────────────
ENVIRONMENT=development         # development | production
APP_NAME=SmartLog
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ── AWS (optional — for file uploads to S3) ─────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=smartlog-uploads

# ── Embedding model ──────────────────────────────────
# HuggingFace model name — no API key needed (runs locally)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
